rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && request.auth.uid == "6flMuzAdeBZBpyBMKz0XP8DAvGt1";
    }

    function validScore() {
      return request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 100000000
        && request.resource.data.updatedAt is int;
    }

    function validPlayerIdentity() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() > 0
        && request.resource.data.playerId.size() <= 64;
    }

    function validMenuItem() {
      return request.resource.data.keys().hasOnly([
          "name",
          "description",
          "price",
          "priceOptions",
          "img",
          "isSignature",
          "timestamp"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.price is string
        && request.resource.data.price.size() > 0
        && request.resource.data.price.size() <= 50
        && request.resource.data.priceOptions is list
        && request.resource.data.priceOptions.size() > 0
        && request.resource.data.priceOptions.size() <= 12
        && request.resource.data.img is string
        && request.resource.data.img.size() <= 900000
        && request.resource.data.isSignature is bool
        && request.resource.data.timestamp is int;
    }

    match /artifacts/pastry-pup-final/public/data/menuItems/{itemId} {
      allow read: if true;
      allow create, update: if isStaff() && validMenuItem();
      allow delete: if isStaff();
    }

    match /artifacts/pastry-pup-final/public/data/watermelonScores/{scoreId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "ownerUid",
          "playerId",
          "bestScore",
          "updatedAt"
        ])
        && validPlayerIdentity()
        && validScore();
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "ownerUid",
          "playerId",
          "bestScore",
          "updatedAt"
        ])
        && validPlayerIdentity()
        && validScore()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.name == resource.data.name
        && request.resource.data.bestScore >= resource.data.bestScore;
      allow delete: if isStaff();
    }

    match /artifacts/pastry-pup-final/public/data/arcadeScores/{gameId}/players/{scoreId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "ownerUid",
          "playerId",
          "bestScore",
          "updatedAt",
          "level",
          "difficulty",
          "bestCombo"
        ])
        && validPlayerIdentity()
        && validScore();
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly([
          "name",
          "ownerUid",
          "playerId",
          "bestScore",
          "updatedAt",
          "level",
          "difficulty",
          "bestCombo"
        ])
        && validPlayerIdentity()
        && validScore()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.name == resource.data.name
        && request.resource.data.bestScore >= resource.data.bestScore;
      allow delete: if isStaff();
    }
  }
}

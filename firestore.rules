rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && request.auth.uid == "6flMuzAdeBZBpyBMKz0XP8DAvGt1";
    }

    function validScore() {
      return request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 100000000
        && request.resource.data.updatedAt is int;
    }

    match /artifacts/pastry-pup-final/public/data/menuItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isStaff();
    }

    match /artifacts/pastry-pup-final/public/data/watermelonScores/{userId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["name", "bestScore", "updatedAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && validScore();
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["name", "bestScore", "updatedAt"])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && validScore()
        && request.resource.data.bestScore >= resource.data.bestScore;
      allow delete: if isStaff();
    }

    match /artifacts/pastry-pup-final/public/data/arcadeScores/{gameId}/players/{userId} {
      allow read: if true;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "bestScore",
          "updatedAt",
          "level",
          "difficulty",
          "bestCombo"
        ])
        && validScore();
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "bestScore",
          "updatedAt",
          "level",
          "difficulty",
          "bestCombo"
        ])
        && validScore()
        && request.resource.data.bestScore >= resource.data.bestScore;
      allow delete: if isStaff();
    }
  }
}
